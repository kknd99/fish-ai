################################################################################
# 🚀 1. 必填核心配置 (AI 模型)
# 只有配置了 AI，本项目才能实现智能分析。建议优先完成此处配置。
################################################################################

# 模型的 API Key。
OPENAI_API_KEY=sk-...

# 模型的 API 接口地址。
# 这里需要填写服务商提供的、兼容 OpenAI 格式的 API 地址。
# 例如: https://api.openai.com/v1/ 或国内大模型厂商提供的地址。
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1/

# 使用的模型名称。
# 注意：该模型必须支持图片分析功能 (Vision)。
OPENAI_MODEL_NAME=XiaomiMiMo/MiMo-V2-Flash


################################################################################
# 🖥️ 2. Web 管理界面配置
# 用于访问控制台，保护你的配置不被他人篡改。
################################################################################

# 服务运行端口 (默认 8000)
SERVER_PORT=8000

# 管理员账号与密码 (默认 admin / admin123)
WEB_USERNAME=admin
WEB_PASSWORD=admin123


################################################################################
# 🕷️ 3. 爬虫基础设置
# 控制浏览器的运行行为。
################################################################################

# 爬虫是否以无头模式运行 (默认 true)。
# 注意：使用 Docker 部署时必须设为 true。
RUN_HEADLESS=true

# 是否使用 Edge 浏览器内核 (默认 false, 即使用 Chrome)。
# 仅影响本地浏览器通道；Docker 镜像未内置 Edge，容器内会固定使用 Chromium。
LOGIN_IS_EDGE=false

# 是否开启自动转换：将电脑端链接转换为手机端链接 (建议开启)
PCURL_TO_MOBILE=true


################################################################################
# 🛠️ 4. AI 策略与兼容性 (可选)
# 如果你发现 AI 分析不准确或报错，请尝试调整此处。
################################################################################

# AI 调试模式 (默认 false)。开启后控制台会打印详细的 AI 分析日志。
AI_DEBUG_MODE=false

# (可选) 为 AI 请求配置 HTTP/S 代理。支持 http 和 socks5。
# 例如: http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
PROXY_URL=""

# 是否启用 enable_thinking 参数 (某些模型如 DeepSeek 可能需要，默认 false)
ENABLE_THINKING=false

# 是否启用 response_format (默认 true)。
# 豆包模型等不支持 json_object 格式的需设为 false；Gemini/GPT 等建议设为 true。
ENABLE_RESPONSE_FORMAT=true


################################################################################
# 📢 5. 消息推送配置 (可选)
# 只要配置其中一个即可收到通知。
################################################################################

# --- ntfy (推荐) ---
NTFY_TOPIC_URL=

# --- Bark (iOS 推荐) ---
# 例如: https://api.day.app/your_key
BARK_URL=

# --- 企业微信机器人 ---
WX_BOT_URL=

# --- 飞书自定义机器人 ---
# 群机器人 → 添加机器人 → 自定义机器人，复制 Webhook 地址
FEISHU_BOT_URL=
# 可选：机器人开启「签名校验」时必填（否则消息会被拒）
FEISHU_BOT_SECRET=
# 可选：自建应用凭证，填了才会推送商品缩略图（飞书发图必须先上传换 image_key，
# 而上传接口需要 tenant_access_token）。两个必须成对填写；留空则只发纯文本。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- Telegram 机器人 ---
# 获取 Token 找 @BotFather，获取 Chat ID 找 @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 可选：Telegram Bot API 反代地址，默认 https://api.telegram.org
TELEGRAM_API_BASE_URL=

# --- Gotify ---
GOTIFY_URL=
GOTIFY_TOKEN=

# --- 通用 Webhook ---
WEBHOOK_URL=
WEBHOOK_METHOD="POST"
WEBHOOK_CONTENT_TYPE="JSON"
WEBHOOK_HEADERS='{"X-API-TOKEN":"your-secret-token"}'
WEBHOOK_QUERY_PARAMETERS='{"title":"{{title}}","content":"{{content}}"}'
WEBHOOK_BODY='{"title":"{{title}}","content":"{{content}}"}'


################################################################################
# 🛡️ 6. 高级功能 (可选)
################################################################################

# --- 任务失败保护 ---
# 当任务持续失败(如 Cookie 失效)时，自动暂停避免风控。
TASK_FAILURE_THRESHOLD=3
TASK_FAILURE_PAUSE_SECONDS=86400
# 状态文件路径 (默认 logs/task-failure-guard.json)
TASK_FAILURE_GUARD_PATH=

# --- 任务运行日志清理 ---
# 启动时自动清理 logs/*.log 中超过保留天数的历史日志（默认 7 天）
TASK_LOG_RETENTION_DAYS=7

# --- 代理池轮换 ---
PROXY_ROTATION_ENABLED=false
# per_task 或 on_failure
PROXY_ROTATION_MODE="per_task"
PROXY_POOL=""
PROXY_ROTATION_RETRY_LIMIT=2
PROXY_BLACKLIST_TTL=300

################################################################################
# --- 交易（自动下单）---
# 默认全程关闭，且即使开启也默认只演练、不提交订单。
# 注意：把 TRADE_ENABLED 打开之前，请先确认已配置金额上限并保持 TRADE_DRY_RUN=true
# 跑一段时间，用 trade_attempts 审计表核对命中质量。
# 安全前提：判定来自 LLM，而 LLM 的输入包含卖家可控文本，因此花钱动作必须过
# 资金闸门；另外请务必同时为 /api/* 加上认证（交易开启后这个前提不能省）。

# 总开关（默认 false）
TRADE_ENABLED=false
# 演练模式（默认 true）：只写审计、不产生任何下单动作
TRADE_DRY_RUN=true
# 执行方式：dry_run | notify_link | playwright_checkout
# notify_link = 只推送真实商品链接与人工确认指引（推荐先用这个）
# playwright_checkout = 自动提交订单，尚未实现
TRADE_ADAPTER=notify_link

# 单件价格上限（元）。为 0 表示未设置 → 闸门会拒绝放行（不是不限额）
TRADE_MAX_UNIT_PRICE=0
# 每日总预算上限（元）。为 0 表示未设置 → 拒绝放行
TRADE_DAILY_BUDGET=0
# 每日下单数量上限。为 0 表示禁止下单
TRADE_MAX_ORDERS_PER_DAY=0
# 卖家白名单，逗号分隔；留空表示不限制
TRADE_ALLOWED_SELLERS=""
# 要求 AI 给出的价值评分下限（0 = 不要求）
TRADE_MIN_VALUE_SCORE=0
# 急停开关文件路径：该文件存在时立即停止一切交易动作
TRADE_KILL_SWITCH_FILE=TRADE_KILL_SWITCH

# --- 降价提醒 ---
# 已推送过的商品若创出历史新低，再提醒一次（独立于推荐通知）。
# 检测发生在去重之前：会降价的恰恰是"已存在"的商品，去重会跳过它们。
# 提醒里带商品缩略图（取自搜索列表的 picUrl），飞书会发成图文卡片。
PRICE_DROP_ENABLED=false
# 降幅阈值：金额与比例满足其一即提醒
PRICE_DROP_MIN_AMOUNT=50
PRICE_DROP_MIN_PERCENT=5

# --- 账号轮换 ---
# 登录态失效或命中风控时自动换下一个账号，避免任务被暂停 24 小时。
# 前置条件：state/ 目录里要有多个登录态（*.json），每个账号导出一份。
# 注意：启用轮换后根目录的 xianyu_state.json 不再参与，请在「账号管理」页维护 state/。
# 若只开了开关但 state/ 为空，会回落到 xianyu_state.json（等于没轮换）。
ACCOUNT_ROTATION_ENABLED=false
# per_task：同一任务固定用一个账号，仅在登录失效/风控时换（推荐）
# on_failure：每次失败都换账号并拉黑一段时间
ACCOUNT_ROTATION_MODE=per_task
# 登录态目录（相对项目根目录）
ACCOUNT_STATE_DIR=state
# 单次运行内允许的轮换尝试次数；实际上限不会小于账号池大小
ACCOUNT_ROTATION_RETRY_LIMIT=2
# 失效账号的拉黑时长（秒）；设 0 会关闭黑名单，失效账号可能被重复选中
ACCOUNT_BLACKLIST_TTL=1800

# --- IP（代理）轮换 ---
# 与账号轮换独立；这里的开关是真实生效的。
# 命中风控时换出口 IP，并按指数退避重试（30s 起，最多 10 分钟）。
PROXY_ROTATION_ENABLED=false
PROXY_ROTATION_MODE=per_task
# 代理列表，逗号分隔，形如 http://user:pass@host:port
PROXY_POOL=""
PROXY_BLACKLIST_TTL=1800
